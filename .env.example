# Environment variables for KrakenLab Harness
# Copy to .env.local and fill in values as needed.

# Hermes AI assistant (Groq) — optional; demo mode works without it
GROQ_API_KEY=

# Cursor cloud agent delegation — optional; jobs queue locally without it
CURSOR_API_KEY=

# Webhook channel shared secret — optional; omit to allow open webhooks in dev
HERMES_WEBHOOK_SECRET=

# Supabase (for future persistence) — optional for in-memory demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
