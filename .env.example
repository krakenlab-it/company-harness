# Environment variables for KrakenLab Harness
# Copy to .env.local and fill in values as needed.
#
# IMPORTANT: Do NOT copy empty secret lines like GROQ_API_KEY=
# into .env.local — they override Cursor Environment Secrets.
# Either omit the variable entirely, or paste your real key.

# App URL (used in invite links and OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: skip auth middleware and use admin session (default when Supabase unset)
HARNESS_DEMO_MODE=true

# Hermes AI (Groq) — add to .env.local OR Cursor Cloud Environment secrets:
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Cursor cloud agents — add when delegating:
# CURSOR_API_KEY=

# Webhook shared secret (optional in dev):
# HERMES_WEBHOOK_SECRET=

# Supabase (optional for in-memory demo):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Integrations (uncomment in .env.local when connecting) ---

# OPENROUTER_API_KEY=
# TRIGGER_SECRET_KEY=
# TRIGGER_COST_PER_MINUTE_USD=0.002
# GITHUB_TOKEN=
# GITHUB_ORG=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GCP_PROJECT_ID=
# GCP_BILLING_ACCOUNT_ID=
# GCP_SERVICE_ACCOUNT_JSON=
# GCP_MONTHLY_SPEND_USD=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=KrakenLab <onboarding@resend.dev>
