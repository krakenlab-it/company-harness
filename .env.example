# Environment variables for KrakenLab Harness
# Copy to .env.local and fill in values as needed.

# App URL (used in invite links and OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: skip auth middleware and use admin session (default when Supabase unset)
HARNESS_DEMO_MODE=true

# Hermes AI assistant (Groq) — https://console.groq.com/docs/quickstart
GROQ_API_KEY=
# Optional override (default openai/gpt-oss-120b — Groq flagship, tool calling)
GROQ_MODEL=

# Cursor cloud agent delegation — https://cursor.com/docs/cloud-agent/api/v0
CURSOR_API_KEY=

# Webhook channel shared secret — optional; omit to allow open webhooks in dev
HERMES_WEBHOOK_SECRET=

# Supabase (persistence + auth) — optional for in-memory demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Integrations (add keys to connect live services) ---

# OpenRouter — token usage and spend
OPENROUTER_API_KEY=

# Trigger.dev — runs, sessions, estimated spend
TRIGGER_SECRET_KEY=
TRIGGER_COST_PER_MINUTE_USD=0.002

# GitHub — sync repos and link to projects
GITHUB_TOKEN=
GITHUB_ORG=

# Google OAuth — Gmail + Calendar (also used for Supabase Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GCP — billing and Cloud Run health
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT_ID=
GCP_SERVICE_ACCOUNT_JSON=
GCP_MONTHLY_SPEND_USD=

# Resend — team invite emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=KrakenLab <onboarding@resend.dev>
